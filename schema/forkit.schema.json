{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyecusch/forkit/schema/forkit.schema.json",
  "title": "Forkit shared data model",
  "$defs": {
    "RepoId": { "type": "string", "description": "Hash of the repository's canonical common git dir." },
    "WorktreeId": { "type": "string", "description": "Hash of the worktree's absolute path." },
    "RefId": { "type": "string", "description": "repoId:fullName, e.g. r1:refs/heads/main." },
    "RemoteId": { "type": "string", "description": "repoId:name, e.g. r1:origin." },
    "Oid": { "type": "string", "description": "Full commit hash." },
    "UnixMillis": { "type": "integer", "format": "int64" },

    "LoadState": { "enum": ["loading", "ready", "error"] },
    "Repo": {
      "type": "object",
      "required": ["id", "name", "commonDir", "isBare", "defaultBranch", "mainWorktreeId", "lastOpenedAt", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/RepoId" },
        "name": { "type": "string" },
        "commonDir": { "type": "string" },
        "isBare": { "type": "boolean" },
        "defaultBranch": { "type": "string" },
        "mainWorktreeId": { "$ref": "#/$defs/WorktreeId" },
        "lastOpenedAt": { "$ref": "#/$defs/UnixMillis" },
        "state": { "$ref": "#/$defs/LoadState" },
        "error": { "type": "string" }
      }
    },

    "HeadKind": { "enum": ["branch", "detached", "unborn"] },
    "WorktreeHead": {
      "type": "object",
      "required": ["kind", "oid"],
      "properties": {
        "kind": { "$ref": "#/$defs/HeadKind" },
        "refId": { "$ref": "#/$defs/RefId" },
        "oid": { "$ref": "#/$defs/Oid" }
      }
    },
    "WorktreeOperation": { "enum": ["none", "merge", "rebase", "cherryPick", "revert", "bisect"] },
    "StatusSummary": {
      "type": "object",
      "required": ["staged", "unstaged", "untracked", "conflicted", "revision"],
      "properties": {
        "staged": { "type": "integer" },
        "unstaged": { "type": "integer" },
        "untracked": { "type": "integer" },
        "conflicted": { "type": "integer" },
        "revision": { "type": "integer", "description": "Counts up each time the worktree's status is read, so views of file contents know to refresh." }
      }
    },
    "Worktree": {
      "type": "object",
      "required": ["id", "repoId", "path", "isMain", "locked", "prunable", "head", "operation", "statusSummary"],
      "properties": {
        "id": { "$ref": "#/$defs/WorktreeId" },
        "repoId": { "$ref": "#/$defs/RepoId" },
        "path": { "type": "string" },
        "isMain": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "prunable": { "type": "boolean" },
        "head": { "$ref": "#/$defs/WorktreeHead" },
        "operation": { "$ref": "#/$defs/WorktreeOperation" },
        "statusSummary": { "$ref": "#/$defs/StatusSummary" }
      }
    },

    "RefKind": { "enum": ["localBranch", "remoteBranch", "tag", "stash"] },
    "Ref": {
      "type": "object",
      "required": ["id", "repoId", "fullName", "shortName", "kind", "targetOid"],
      "properties": {
        "id": { "$ref": "#/$defs/RefId" },
        "repoId": { "$ref": "#/$defs/RepoId" },
        "fullName": { "type": "string" },
        "shortName": { "type": "string" },
        "kind": { "$ref": "#/$defs/RefKind" },
        "targetOid": { "$ref": "#/$defs/Oid" },
        "peeledOid": { "$ref": "#/$defs/Oid", "description": "Commit an annotated tag points at." },
        "remoteId": { "$ref": "#/$defs/RemoteId" },
        "upstreamRefId": { "$ref": "#/$defs/RefId" },
        "ahead": { "type": "integer" },
        "behind": { "type": "integer" },
        "checkedOutInWorktreeId": { "$ref": "#/$defs/WorktreeId" },
        "date": { "$ref": "#/$defs/UnixMillis", "description": "When an annotated tag was made, or for any other ref, when the commit it points at was committed." }
      }
    },

    "FetchState": { "enum": ["idle", "fetching", "error"] },
    "Remote": {
      "type": "object",
      "required": ["id", "repoId", "name", "fetchUrl", "pushUrl", "fetchState"],
      "properties": {
        "id": { "$ref": "#/$defs/RemoteId" },
        "repoId": { "$ref": "#/$defs/RepoId" },
        "name": { "type": "string" },
        "fetchUrl": { "type": "string" },
        "pushUrl": { "type": "string" },
        "lastFetchedAt": { "$ref": "#/$defs/UnixMillis" },
        "fetchState": { "$ref": "#/$defs/FetchState" }
      }
    },

    "StatusCode": {
      "enum": ["unmodified", "modified", "typeChanged", "added", "deleted", "renamed", "copied", "untracked", "ignored", "unmerged"]
    },
    "FileStatus": {
      "type": "object",
      "required": ["id", "worktreeId", "path", "index", "workTree"],
      "properties": {
        "id": { "type": "string", "description": "worktreeId:path." },
        "worktreeId": { "$ref": "#/$defs/WorktreeId" },
        "path": { "type": "string" },
        "oldPath": { "type": "string" },
        "index": { "$ref": "#/$defs/StatusCode" },
        "workTree": { "$ref": "#/$defs/StatusCode" },
        "conflict": { "type": "string", "description": "Two-letter unmerged code from git status, e.g. UU or AA." }
      }
    },

    "OperationKind": { "enum": ["checkout", "createWorktree", "removeWorktree", "deleteBranches", "fetch", "pull", "push", "stash", "applyStash", "dropStash"] },
    "OperationState": { "enum": ["queued", "running", "done", "failed", "cancelled"] },
    "OperationProgress": {
      "type": "object",
      "required": ["phase", "current", "total"],
      "properties": {
        "phase": { "type": "string" },
        "current": { "type": "integer" },
        "total": { "type": "integer" }
      }
    },
    "Operation": {
      "type": "object",
      "required": ["id", "repoId", "kind", "state", "traceId"],
      "properties": {
        "id": { "type": "string" },
        "repoId": { "$ref": "#/$defs/RepoId" },
        "worktreeId": { "$ref": "#/$defs/WorktreeId" },
        "kind": { "$ref": "#/$defs/OperationKind" },
        "state": { "$ref": "#/$defs/OperationState" },
        "progress": { "$ref": "#/$defs/OperationProgress" },
        "error": { "$ref": "#/$defs/RpcError" },
        "traceId": { "type": "string" }
      }
    },

    "CheckoutMode": {
      "description": "What to do with uncommitted changes: refuse to check out, stash them and reapply them afterwards, or let git carry them over.",
      "enum": ["safe", "stash", "carry"]
    },
    "CheckoutResult": {
      "type": "object",
      "required": ["reapplyConflicted"],
      "properties": {
        "branch": { "$ref": "#/$defs/RefId", "description": "The local branch now checked out; absent for a detached HEAD." },
        "reapplyConflicted": { "type": "boolean", "description": "Stashed changes conflicted when reapplied and were left in the stash." }
      }
    },
    "ApplyStashResult": {
      "type": "object",
      "required": ["conflicted"],
      "properties": {
        "conflicted": { "type": "boolean", "description": "The stash conflicted with the worktree's files, which now hold conflict markers; a pop keeps the stash." }
      }
    },

    "InitRepoResult": {
      "type": "object",
      "required": ["repo", "created"],
      "properties": {
        "repo": { "$ref": "#/$defs/Repo" },
        "created": { "type": "boolean", "description": "A new repository was made; false when the folder already held one, which was opened instead." }
      }
    },

    "Appearance": { "enum": ["system", "light", "dark"], "description": "Which of the light and dark themes is used; system follows the operating system." },
    "LightTheme": { "enum": ["tokyo-night-day", "catppuccin-latte", "github-light", "one-light", "gruvbox-light", "solarized-light", "rose-pine-dawn"] },
    "DarkTheme": { "enum": ["tokyo-night", "catppuccin-mocha", "catppuccin-macchiato", "catppuccin-frappe", "dracula", "nord", "one-dark", "github-dark", "gruvbox-dark", "solarized-dark", "rose-pine", "rose-pine-moon"] },
    "DateFormat": { "enum": ["relative", "absolute", "iso"] },
    "GraphOrder": { "enum": ["topo", "date"] },
    "DirtyCheckout": { "enum": ["ask", "stash", "carry"] },
    "TelemetryMode": { "enum": ["local", "otlp"] },
    "AppearancePreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appearance", "lightTheme", "darkTheme", "fontSize", "dateFormat", "gravatars"],
      "properties": {
        "appearance": { "$ref": "#/$defs/Appearance" },
        "lightTheme": { "$ref": "#/$defs/LightTheme" },
        "darkTheme": { "$ref": "#/$defs/DarkTheme" },
        "fontSize": { "type": "integer", "minimum": 10, "maximum": 20 },
        "dateFormat": { "$ref": "#/$defs/DateFormat" },
        "gravatars": { "type": "boolean", "description": "Show authors' Gravatar pictures, which sends a hash of each author's email to Gravatar." }
      }
    },
    "GraphPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "showRemoteBranches", "showTags", "showStashes"],
      "properties": {
        "order": { "$ref": "#/$defs/GraphOrder" },
        "showRemoteBranches": { "type": "boolean" },
        "showTags": { "type": "boolean" },
        "showStashes": { "type": "boolean" }
      }
    },
    "DiffLayout": { "enum": ["unified", "split"], "description": "One column of old and new lines, or old and new side by side." },
    "DiffPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignoreWhitespace", "layout"],
      "properties": {
        "ignoreWhitespace": { "type": "boolean", "description": "Treat lines that differ only in spacing as unchanged." },
        "layout": { "$ref": "#/$defs/DiffLayout" }
      }
    },
    "GitPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binaryPath", "maintainCommitGraph", "fetchInterval", "pruneOnFetch", "pullMode"],
      "properties": {
        "binaryPath": { "type": "string", "description": "Empty means find git on PATH." },
        "maintainCommitGraph": { "type": "boolean", "description": "Write git's commit-graph file when it is missing, which speeds up history walks." },
        "fetchInterval": { "type": "integer", "minimum": 0, "maximum": 120, "description": "Minutes between fetches in the background; 0 turns them off." },
        "pruneOnFetch": { "type": "boolean", "description": "Remove remote-tracking branches whose branch is gone from the remote." },
        "pullMode": { "$ref": "#/$defs/PullMode" }
      }
    },
    "PullMode": {
      "enum": ["ffOnly", "merge", "rebase"],
      "description": "How a pull brings in the upstream's commits when the branch has its own: refuse, merge them, or rebase onto them."
    },
    "TagOrder": {
      "description": "How the sidebar orders tags: by version, newest first, with tags that are not versions after them; by date, newest first; or by name.",
      "enum": ["version", "date", "name"]
    },
    "SidebarPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagOrder"],
      "properties": {
        "tagOrder": { "$ref": "#/$defs/TagOrder" }
      }
    },
    "BehaviourPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dirtyCheckout"],
      "properties": {
        "dirtyCheckout": { "$ref": "#/$defs/DirtyCheckout" }
      }
    },
    "TelemetryPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "otlpEndpoint"],
      "properties": {
        "mode": { "$ref": "#/$defs/TelemetryMode" },
        "otlpEndpoint": { "type": "string" }
      }
    },
    "Preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "appearance", "graph", "sidebar", "diff", "git", "behaviour", "telemetry"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer" },
        "appearance": { "$ref": "#/$defs/AppearancePreferences" },
        "graph": { "$ref": "#/$defs/GraphPreferences" },
        "sidebar": { "$ref": "#/$defs/SidebarPreferences" },
        "diff": { "$ref": "#/$defs/DiffPreferences" },
        "git": { "$ref": "#/$defs/GitPreferences" },
        "behaviour": { "$ref": "#/$defs/BehaviourPreferences" },
        "telemetry": { "$ref": "#/$defs/TelemetryPreferences" }
      }
    },

    "OpenRepo": {
      "type": "object",
      "required": ["id", "commonDir"],
      "properties": {
        "id": { "$ref": "#/$defs/RepoId" },
        "commonDir": { "type": "string" },
        "activeWorktreeId": { "$ref": "#/$defs/WorktreeId" },
        "emphasizedRefId": { "$ref": "#/$defs/RefId" }
      }
    },
    "Session": {
      "type": "object",
      "required": ["id", "openRepos"],
      "properties": {
        "id": { "type": "string" },
        "openRepos": { "type": "array", "items": { "$ref": "#/$defs/OpenRepo" } },
        "activeRepoId": { "$ref": "#/$defs/RepoId" },
        "layout": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "description": "Sizes the user has given panels and columns, by LayoutSize. Widths are in pixels and splits are the first part's fraction; a missing size is chosen automatically."
        }
      }
    },
    "LayoutSize": {
      "enum": ["sidebar", "details", "staged", "diffSplit", "refsColumn", "graphColumn"],
      "description": "A panel or column the user can resize."
    },

    "Commit": {
      "type": "object",
      "required": ["oid", "parents", "authorName", "authorEmail", "authorTime", "committerTime", "subject"],
      "properties": {
        "oid": { "$ref": "#/$defs/Oid" },
        "parents": { "type": "array", "items": { "$ref": "#/$defs/Oid" } },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorTime": { "$ref": "#/$defs/UnixMillis" },
        "committerTime": { "$ref": "#/$defs/UnixMillis" },
        "subject": { "type": "string" }
      }
    },
    "EdgeKind": { "enum": ["straight", "merge", "fork"] },
    "GraphEdge": {
      "type": "object",
      "description": "A line from a lane in this row to a lane in the next row.",
      "required": ["fromLane", "toLane", "threadId", "kind"],
      "properties": {
        "fromLane": { "type": "integer" },
        "toLane": { "type": "integer" },
        "threadId": { "type": "integer" },
        "kind": { "$ref": "#/$defs/EdgeKind" },
        "uncommitted": { "type": "boolean", "description": "Part of the line from the active worktree's uncommitted changes, above the first row, to the commit they build on." },
        "stash": { "type": "boolean", "description": "Part of the line from a stash to the commit it was made on." }
      }
    },
    "GraphRow": {
      "type": "object",
      "required": ["index", "oid", "lane", "threadId", "edges", "refIds", "onEmphasized"],
      "properties": {
        "index": { "type": "integer" },
        "oid": { "$ref": "#/$defs/Oid" },
        "lane": { "type": "integer" },
        "threadId": { "type": "integer" },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/GraphEdge" } },
        "refIds": { "type": "array", "items": { "$ref": "#/$defs/RefId" } },
        "onEmphasized": { "type": "boolean" },
        "stash": { "type": "boolean", "description": "The row is a stash rather than a commit of history; its threadId is not a branch's." }
      }
    },
    "GraphView": {
      "type": "object",
      "required": ["id", "version", "totalRows", "stashRows", "laneCount", "complete", "firstChangedRow", "branchThreads"],
      "properties": {
        "id": { "$ref": "#/$defs/RepoId" },
        "version": { "type": "integer" },
        "totalRows": { "type": "integer" },
        "stashRows": { "type": "integer", "description": "How many of the rows are stashes rather than commits." },
        "laneCount": { "type": "integer" },
        "complete": { "type": "boolean", "description": "False while history is still streaming in." },
        "firstChangedRow": { "type": "integer", "description": "Rows before this index are unchanged since the previous version." },
        "branchThreads": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "The thread of each local branch's commit, by ref ID, so a branch can be shown in its line's colour."
        }
      }
    },
    "GraphWindow": {
      "type": "object",
      "required": ["version", "start", "rows", "commits"],
      "properties": {
        "version": { "type": "integer" },
        "start": { "type": "integer" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/GraphRow" } },
        "commits": { "type": "array", "items": { "$ref": "#/$defs/Commit" } }
      }
    },
    "FileChangeStatus": { "enum": ["added", "modified", "deleted", "renamed", "copied", "typeChanged"] },
    "FileChange": {
      "type": "object",
      "required": ["path", "status", "additions", "deletions", "binary"],
      "properties": {
        "path": { "type": "string" },
        "oldPath": { "type": "string" },
        "status": { "$ref": "#/$defs/FileChangeStatus" },
        "additions": { "type": "integer" },
        "deletions": { "type": "integer" },
        "binary": { "type": "boolean" },
        "diffOid": { "$ref": "#/$defs/Oid", "description": "The commit whose diff shows this file, when not the one listing it: a stash keeps its untracked files in a commit of their own." }
      }
    },
    "DiffKind": { "enum": ["commit", "staged", "unstaged", "untracked"], "description": "Where a file's changes come from: a commit against its first parent, or a worktree's index or files." },
    "DiffRequest": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "$ref": "#/$defs/DiffKind" },
        "oid": { "$ref": "#/$defs/Oid", "description": "The commit, for a commit diff." },
        "worktreeId": { "$ref": "#/$defs/WorktreeId", "description": "The worktree, for every other kind." },
        "path": { "type": "string" },
        "oldPath": { "type": "string", "description": "The path before a rename or copy." },
        "ignoreWhitespace": { "type": "boolean", "description": "Treat lines that differ only in spacing as unchanged." }
      }
    },
    "DiffLineKind": { "enum": ["context", "added", "removed"] },
    "DiffLine": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": { "$ref": "#/$defs/DiffLineKind" },
        "oldLine": { "type": "integer" },
        "newLine": { "type": "integer" },
        "text": { "type": "string" },
        "noNewline": { "type": "boolean", "description": "The file ends on this line without a newline." }
      }
    },
    "DiffHunk": {
      "type": "object",
      "required": ["oldStart", "oldLines", "newStart", "newLines", "section", "lines"],
      "properties": {
        "oldStart": { "type": "integer" },
        "oldLines": { "type": "integer" },
        "newStart": { "type": "integer" },
        "newLines": { "type": "integer" },
        "section": { "type": "string", "description": "The enclosing function or heading git names after the hunk's range, if any." },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/DiffLine" } }
      }
    },
    "FileDiff": {
      "type": "object",
      "required": ["path", "binary", "truncated", "hunks"],
      "properties": {
        "path": { "type": "string" },
        "oldPath": { "type": "string" },
        "binary": { "type": "boolean" },
        "truncated": { "type": "boolean", "description": "The diff was cut short at the line limit." },
        "hunks": { "type": "array", "items": { "$ref": "#/$defs/DiffHunk" } }
      }
    },
    "CommitDetail": {
      "type": "object",
      "required": ["oid", "parents", "authorName", "authorEmail", "authorTime", "committerName", "committerEmail", "committerTime", "body", "files"],
      "properties": {
        "oid": { "$ref": "#/$defs/Oid" },
        "parents": { "type": "array", "items": { "$ref": "#/$defs/Oid" } },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorTime": { "$ref": "#/$defs/UnixMillis" },
        "committerName": { "type": "string" },
        "committerEmail": { "type": "string" },
        "committerTime": { "$ref": "#/$defs/UnixMillis" },
        "body": { "type": "string" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/FileChange" } }
      }
    },

    "ErrorCode": {
      "enum": [
        "NotARepo",
        "RepoNotOpen",
        "RefNotFound",
        "WorktreeNotFound",
        "DirtyWorktree",
        "BranchCheckedOutElsewhere",
        "OperationInProgress",
        "IndexLocked",
        "AuthFailed",
        "PushRejected",
        "Diverged",
        "NoUpstream",
        "GitNotFound",
        "GitTooOld",
        "GitFailed",
        "InvalidArgument",
        "Cancelled",
        "Internal"
      ]
    },
    "RpcError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string" },
        "details": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },

    "CallMeta": {
      "type": "object",
      "description": "Sent with every RPC call so the backend continues the caller's trace.",
      "required": ["traceparent"],
      "properties": {
        "traceparent": { "type": "string" }
      }
    },

    "SyncOpType": { "enum": ["insert", "update", "delete"] },
    "SyncOp": {
      "type": "object",
      "required": ["type", "key"],
      "properties": {
        "type": { "$ref": "#/$defs/SyncOpType" },
        "key": { "type": "string" },
        "value": { "description": "The entity, absent for deletes." }
      }
    },
    "SyncDelta": {
      "type": "object",
      "required": ["seq", "prevSeq", "traceparent", "ops"],
      "properties": {
        "seq": { "type": "integer" },
        "prevSeq": { "type": "integer" },
        "traceparent": { "type": "string" },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/SyncOp" } }
      }
    },
    "SyncSnapshot": {
      "type": "object",
      "required": ["seq", "entities"],
      "properties": {
        "seq": { "type": "integer" },
        "entities": { "type": "array", "items": {} }
      }
    }
  }
}
